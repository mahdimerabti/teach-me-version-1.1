# ==============================================================================
# Teach Me — Environment Variables Template (.env.example)
# Copy to .env for local development. NEVER commit real secrets to Git.
# ==============================================================================

# --- Public Client Configuration (Safe for Browser / Vite Bundle) ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-supabase-anon-key
VITE_PRODUCTION_URL=https://teachmelearn.netlify.app
VITE_VAPID_PUBLIC_KEY=your-public-web-push-vapid-key
VITE_PAID_PLANS_ENABLED=false
VITE_FREE_TRIAL_CREDITS=2
VITE_CHARGILY_PUBLIC_KEY=
VITE_CHARGILY_MODE=test

# --- Server-Only Secrets (Set ONLY in Supabase Edge Function Secrets / CI) ---
# NEVER prefix secret keys, service-role keys, or passwords with VITE_!
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# CHARGILY_SECRET_KEY=your-chargily-secret-key
# CHARGILY_WEBHOOK_SECRET=your-chargily-webhook-secret
# VAPID_PRIVATE_KEY=your-private-vapid-key
# ALLOWED_ORIGINS=https://teachmelearn.netlify.app,http://localhost:5173
