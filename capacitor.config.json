{
  "appId": "com.teachme.app",
  "appName": "Teach Me",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "hostname": "teachmelearn.netlify.app",
    "allowNavigation": [
      "*.supabase.co",
      "*.supabase.in",
      "meet.jit.si",
      "*.jit.si",
      "teachmelearn.netlify.app",
      "teach-me-app-one.vercel.app",
      "accounts.google.com",
      "*.googleapis.com"
    ]
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false,
    "adjustMarginsForEdgeToEdge": "force"
  },
  "plugins": {
    "Browser": {
      "presentationStyle": "popover"
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#ffffff",
      "overlaysWebView": false
    }
  }
}
